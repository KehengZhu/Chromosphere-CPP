#!/bin/sh
# Gate commits that change documented sources on a clean Doxygen build.
#
# docs/doxygen/html/ is NOT tracked (see .gitignore) — the browsable copy is
# published to https://kehengphysics.site/docs/chromosphere/ with
# scripts/publish_docs.sh. So this hook no longer stages anything. Its job is to
# catch the one thing that cannot be fixed after the fact: a new public entity
# committed with no documentation, which Doxygen reports as a warning.
#
# Install with:  scripts/install_hooks.sh
# Skip once with: git commit --no-verify
# Disable entirely: git config chromo.docs-hook false
#
# The hook rebuilds ONLY when a documentation input is staged, so an ordinary
# commit that touches nothing Doxygen reads costs one `git diff --cached` call.

set -eu

[ "$(git config --bool chromo.docs-hook || echo true)" = "false" ] && exit 0

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# The Doxyfile's INPUT list, plus the Doxyfile itself.
staged=$(git diff --cached --name-only --diff-filter=ACMR -- \
    'docs/doxygen/Doxyfile' \
    'docs/doxygen/pages/*' \
    '*.hpp' '*.cpp' \
    'src/*' 'scenarios/*' 'chromo_main.cpp')

[ -z "$staged" ] && exit 0

if ! command -v doxygen >/dev/null 2>&1; then
    echo "pre-commit: doxygen is not installed, so the reference cannot be" >&2
    echo "            checked for this commit. Install it (brew install doxygen)" >&2
    echo "            or run: git config chromo.docs-hook false" >&2
    exit 1
fi

echo "pre-commit: documentation inputs changed, checking the Doxygen build"
if ! scripts/build_docs.sh >/dev/null 2>&1; then
    echo "pre-commit: scripts/build_docs.sh failed. Run it directly to see why." >&2
    exit 1
fi

# Warning-free is the standard: EXTRACT_ALL is off and WARN_IF_UNDOCUMENTED is
# on, so a warning here means a new public entity has no documentation.
log="docs/doxygen/doxygen-warnings.log"
if [ -s "$log" ]; then
    echo "pre-commit: Doxygen reported warnings; the reference must stay clean." >&2
    echo "            Fix these, then commit again:" >&2
    sed -n '1,20p' "$log" >&2
    exit 1
fi

echo "pre-commit: reference builds clean."
echo "pre-commit: remember to publish it after this commit:  scripts/publish_docs.sh"
