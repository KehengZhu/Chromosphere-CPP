% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}


% Items
% \setbeamercolor{structure}{fg=Amethyst}
\setbeamertemplate{itemize item}[triangle]
\setbeamercolor{itemize item}{fg=Amethyst}
\setbeamertemplate{navigation symbols}{}  % no navigation on a poster
% Headline
\setbeamercolor{headline}{fg=Maize, bg=Blue}
\setbeamercolor{headline rule}{bg=Blue}

% Author and Institure
\setbeamercolor{headline author}{fg=white}
% \setbeamercolor{date}{fg=Black}
\setbeamercolor{headline institute}{fg=white}

% Line head colors
\setbeamercolor{lower separation line head}{bg=Maize}
\setbeamercolor{upper separation line foot}{bg=Maize}

% Block
\setbeamercolor{block title}{fg=Maize, bg=Blue}
\setbeamercolor{block separator}{bg=Maize}
\setbeamercolor{block body}{fg=black, bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=Blue, bg=lightgray!25}
\setbeamercolor{block alerted separator}{bg=Maize}
\setbeamercolor{block alerted body}{fg=black, bg=lightgray!25}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=darkgray}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
\setbeamertemplate{bibliography entry article}{}
\setbeamertemplate{bibliography entry title}{}
\setbeamertemplate{bibliography entry location}{}
\setbeamertemplate{bibliography entry note}{}
