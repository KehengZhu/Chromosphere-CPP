# Local convenience symlinks, deliberately untracked: both are meaningful only
# in this working copy.
#   SWMF      -> an absolute path outside the repository, so it would dangle in
#                any other clone.
#   AGENTS.md -> CLAUDE.md, so agent tools that look for AGENTS.md read the same
#                instructions. CLAUDE.md is the tracked source of truth; recreate
#                the link with:  ln -s CLAUDE.md AGENTS.md
SWMF
AGENTS.md

__pycache__/
.venv/
.vscode/
util/data/
visualization/
scenarios/data/*.dat
outputs/
# Scratch/ad-hoc scripts and analysis, not part of the codebase.
/tmp/
# (subpaths below are now redundant with /tmp/ but kept for clarity of intent)
/tmp/Chromosphere-CPP/
# scratch run directory used by scripts/release_validation.sh
/tmp/release_validation/

# Generated simulation outputs and per-run logs (if written to root).
out_*.txt
out_*.log
output.log
output.txt
output_*.txt
output_*.log
*.out
*.mp4

# Generated Doxygen output. NOT tracked: it is a build artifact of the sources
# next to it, and committing 448 regenerated files on every documentation change
# bloated the history for no benefit. The browsable copy lives at
#   https://kehengphysics.site/docs/chromosphere/
# published with scripts/publish_docs.sh. Build locally with scripts/build_docs.sh.
docs/doxygen/html/
docs/doxygen/doxygen-warnings.log
